# Packages a dist/ built on the workstation (npm run build:staging or npm run build), so the
# private @zouriel/ui token never enters an image build:
#   docker build -f Dockerfile.prebuilt -t male-move/web .
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/male-move/browser /usr/share/nginx/html
EXPOSE 8080
